{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,

    "moduleResolution": "bundler",
    "module": "ESNext",

    "baseUrl": "..",
    "paths": {
      "@/*": ["client/src/*"],
      "@shared/*": ["shared/*"]
    },

    "types": ["node"],
    "skipLibCheck": true,

    "noImplicitAny": false
  },
  "include": ["../server/**/*", "../shared/**/*", "../vite.config.*"],
  "exclude": ["../node_modules", "../dist", "../build"]
}